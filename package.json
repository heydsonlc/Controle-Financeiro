{
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.js",
    "test:e2e:smoke:headed": "playwright test tests/e2e/smoke.spec.js --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:functional": "playwright test tests/e2e/functional/ --workers=1",
    "test:e2e:functional:safe": "playwright test tests/e2e/functional/ --grep \"\\[safe\\]\" --workers=1",
    "test:e2e:functional:create": "playwright test tests/e2e/functional/ --grep \"\\[create\\]\" --workers=1",
    "test:e2e:all": "npm run test:e2e:smoke && npm run test:e2e:functional"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
