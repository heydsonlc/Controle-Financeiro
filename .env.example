# Configuração de Ambiente
# Copie este arquivo para .env.local (desenvolvimento) ou .env.production (produção)

# Ambiente: development ou production
FLASK_ENV=development

# Secret Key (use uma string aleatória em produção)
SECRET_KEY=dev-secret-key-change-in-production
CARTOES_CVV_MASTER_PASSWORD=

# Database Configuration
# Desenvolvimento local: PostgreSQL local e a direcao oficial.
# Use somente localhost/127.0.0.1/::1 em development.
# Nunca use DigitalOcean, banco remoto ou dados reais em development.
DATABASE_URL=postgresql://controle_financeiro:SUA_SENHA_LOCAL@localhost:5432/controle_financeiro_dev

# Fallback temporario/legado SQLite: remova a linha acima e use esta se necessario.
# DATABASE_URL=sqlite:///data/gastos.db

# Para produção (PostgreSQL - DigitalOcean):
# Nao commitar .env.local, .env.production ou segredos reais.
# DATABASE_URL=postgresql://usuario:senha@host:porta/nome_do_banco

# Flask
FLASK_APP=backend/app.py
FLASK_DEBUG=1
