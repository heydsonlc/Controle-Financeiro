# Configuração de Ambiente
# Copie este arquivo para .env.local (uso local). Nunca commitar .env.local,
# .env.staging ou .env.production — todos ficam fora do controle de versão.

# Ambiente: local, staging ou production.
# APP_ENV e a variavel oficial. FLASK_ENV continua funcionando como alias de
# compatibilidade (e 'development' e sinonimo legado de 'local').
APP_ENV=local

# Secret Key — assina a sessao de login e o cookie do Flask.
# Em local, um default fraco e usado se isto ficar vazio (apenas conveniencia
# de desenvolvimento). Em staging/production, a aplicacao recusa iniciar sem
# uma chave forte e explicita aqui (minimo 32 caracteres, sem "dev"/"test"/
# "local"/"change"/valores de exemplo conhecidos).
# Gerar uma chave forte:
#   venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-strong-secret

# Senha de desbloqueio do CVV dos cartoes (CARD-CVV-LOCK-1). Em local, pode
# ficar vazia — o endpoint falha fechado e nunca revela o CVV sem ela. Em
# staging/production, so e exigida se houver algum cartao com CVV cadastrado.
CARTOES_CVV_MASTER_PASSWORD=

# Database Configuration
# Local: PostgreSQL local e a direcao oficial (localhost/127.0.0.1/::1 apenas).
# Nunca aponte para um banco remoto com APP_ENV=local.
DATABASE_URL=postgresql://controle_financeiro:SUA_SENHA_LOCAL@localhost:5432/controle_financeiro_dev

# Fallback temporario/legado SQLite: remova a linha acima e use esta se necessario.
# DATABASE_URL=sqlite:///data/gastos.db

# Para staging/production (PostgreSQL remoto, ex.: Supabase):
# Prefira a connection string do modo "pooler" (transaction/session pooling)
# se o provedor oferecer. Nunca reutilize a service_role key do Supabase
# aqui — essa string e so a conexao direta ao Postgres.
# DATABASE_URL=postgresql://usuario:senha@host:porta/nome_do_banco

# Flask
FLASK_APP=backend/app.py
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Raiz dos arquivos gravados em runtime (uploads, OCR, backups locais).
# Vazio = pasta data/ do projeto. Obrigatorio em production: aponte para o
# disco persistente do host (no Render: /var/data). Caminho absoluto.
DATA_DIR=

# Para expor temporariamente na rede local, use FLASK_HOST=0.0.0.0
# apenas em ambiente controlado. Nao exponha pela internet sem HTTPS
# e sem revisar CORS_ORIGINS.

# ---------------------------------------------------------------------------
# FIN-TRANSFERENCIA-AMBIENTE-1: novo aplicativo (web/), testes e homologacao.
# Cada bloco abaixo vai num arquivo local proprio, ignorado pelo Git.
# Valores reais nunca entram no repositorio; aqui so placeholders.
# ---------------------------------------------------------------------------

# .env.staging — conexao ao Supabase DE TESTE (migrations e homologacao real).
# Usuario no formato postgres.<ref-do-projeto-de-teste>; scripts recusam outros projetos.
# DATABASE_URL=postgresql://postgres.<ref-teste>:<senha>@<host-do-pooler>:5432/postgres
# APP_ENV=staging

# .env.e2e-real — contas de teste A e B do Supabase de teste (dados ficticios).
# CF_EMAIL_A=<email-da-conta-de-teste-a>
# CF_SENHA_A=<senha-da-conta-de-teste-a>
# CF_EMAIL_B=<email-da-conta-de-teste-b>
# CF_SENHA_B=<senha-da-conta-de-teste-b>

# Variaveis de usuario do Windows (nao vao em arquivo .env):
# POSTGREST_BIN=<caminho>\postgrest.exe        # PostgREST 16.5 para o E2E e os testes REST
# CF_MVP_PG_BIN=<caminho>\PostgreSQL\18\bin     # opcional: so se o bin do PostgreSQL nao estiver no PATH
# CF_SUPABASE_PROJECT_REF=<ref-teste>           # opcional: o padrao vem do projeto vinculado na Supabase CLI

# Build do web/ (scripts/build.mjs): so a URL e a chave PUBLICA (sb_publishable_...).
# Os roteiros de homologacao leem a chave publica pela Supabase CLI; nunca usar a service_role aqui.
# SUPABASE_URL=https://<ref-teste>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_<chave-publica>
